{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, uuid, position, version, updated_at, events_from, events_to, events_applied,\n                   assessment_uuid, data AS \"data: Json<Aggregate>\"\n            FROM aggregate\n            WHERE assessment_uuid = $1\n              AND data_type = $2\n              AND events_to <= $3\n            ORDER BY position DESC\n            LIMIT 1\n        ",
